// Esquema de la central camionera.
// Fuente de diseño: contexto/01-EsquemaBD.prisma (con los ajustes de docs/02-revision-esquema-bd.md).
// Los modelos se agregan por módulo conforme avanzamos.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  admin
  coordinator
  supervisor
  hr
  driver
  mechanic
  collector
  vendor
  viewer
}

enum StaffRole {
  driver
  collector
  mechanic
  supervisor
  vendor
  hr
  admin_staff
}

enum StaffStatus {
  active
  inactive
  vacation
  sick_leave
  suspended
}

enum LicenseType {
  A
  B
  C
  D
  E
}

enum CertificationType {
  medical_exam
  first_aid
  defensive_driving
  training
  other
}

enum ShiftType {
  morning
  afternoon
  night
  split
}

enum AttendanceStatus {
  present
  late
  half_day
  absent
  excused
}

enum AttendanceSource {
  manual
  self
  system
}

enum EvaluationStatus {
  draft
  finalized
  acknowledged
}

enum PaymentType {
  daily
  monthly
}

enum PaymentFrequency {
  weekly
  biweekly
}

enum PayrollStatus {
  draft
  closed
  paid
}

enum AdjustmentType {
  perception
  deduction
}

enum ActionType {
  insert
  update
  delete
}

// =====================================================
// AUTH / USERS
// =====================================================

model User {
  id                  String    @id @default(uuid(7)) @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  role                UserRole  @default(viewer)
  fullName            String    @map("full_name") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  lastLogin           DateTime? @map("last_login") @db.Timestamptz()
  // Seguridad de acceso
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  /// Preferencias de la interfaz (secciones ocultas de Inicio, etc.)
  preferences         Json      @default("{}") @db.JsonB

  // Relations
  staff              Staff?
  refreshTokens      RefreshToken[]
  maintenanceOrders  MaintenanceOrder[]  @relation("MaintenanceMechanic")
  incidentsReported  BusIncident[]       @relation("IncidentReporter")
  incidentsReviewed  BusIncident[]       @relation("IncidentReviewer")
  fuelLoadsRecorded  FuelLoad[]          @relation("FuelLoadRecorder")
  fuelLoadsReviewed  FuelLoad[]          @relation("FuelLoadReviewer")
  tripsCreated       Trip[]              @relation("TripCreator")
  tripsCancelled     Trip[]              @relation("TripCanceller")
  tripStatusChanges  TripStatusLog[]
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]
  securityEvents     SecurityEvent[]
  settings           SystemSetting[]
  schedules          StaffSchedule[]
  attendance         StaffAttendance[]
  evaluations        StaffEvaluation[]
  compensations      StaffCompensation[]
  payrollPeriods     PayrollPeriod[]
  payrollAdjustments PayrollAdjustment[]
  ordersSold         Order[]             @relation("OrderSeller")
  promotionsCreated  Promotion[]         @relation("PromotionCreator")
  ticketCheckIns     Ticket[]            @relation("TicketCheckIn")
  paymentsRecorded   Payment[]           @relation("PaymentRecorder")
  refundsCreated     Refund[]            @relation("RefundCreator")
  cashSessions       CashSession[]       @relation("CashSessionUser")
  cashSessionsClosed CashSession[]       @relation("CashSessionCloser")
  cashMovements      CashMovement[]      @relation("CashMovementCreator")
  ticketEvents       TicketEvent[]       @relation("TicketEventUser")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  // Se llena al rotar (no al cerrar sesión): distingue una renovación concurrente de un robo
  rotatedAt        DateTime? @map("rotated_at") @db.Timestamptz()
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  // Hereda el valor del token anterior al rotar: identifica la sesión aunque cambie el token
  sessionStartedAt DateTime  @default(now()) @map("session_started_at") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// =====================================================
// PERSONAL
// =====================================================

model Staff {
  id                String      @id @default(uuid(7)) @db.Uuid
  // Generado desde la secuencia staff_employee_number_seq (ver StaffService)
  employeeNumber    String      @unique @map("employee_number") @db.VarChar(20)
  firstName         String      @map("first_name") @db.VarChar(100)
  lastName          String      @map("last_name") @db.VarChar(100)
  secondLastName    String?     @map("second_last_name") @db.VarChar(100)
  curp              String?     @unique @db.VarChar(18)
  rfc               String?     @unique @db.VarChar(13)
  nss               String?     @unique @db.VarChar(11)
  birthDate         DateTime    @map("birth_date") @db.Date
  email             String?     @db.VarChar(255)
  phone             String      @db.VarChar(20)
  address           String?     @db.Text
  emergencyContact  String?     @map("emergency_contact") @db.VarChar(255)
  emergencyPhone    String?     @map("emergency_phone") @db.VarChar(20)
  role              StaffRole
  status            StaffStatus @default(active)
  hireDate          DateTime    @map("hire_date") @db.Date
  terminationDate   DateTime?   @map("termination_date") @db.Date
  terminationReason String?     @map("termination_reason") @db.Text
  userId            String?     @unique @map("user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user           User?                @relation(fields: [userId], references: [id])
  licenses       StaffLicense[]
  certifications StaffCertification[]
  schedules      StaffSchedule[]
  attendance     StaffAttendance[]
  evaluations    StaffEvaluation[]
  compensations  StaffCompensation[]
  payrollEntries PayrollEntry[]
  tripsDriven    Trip[]               @relation("TripDriver")
  tripsCollected Trip[]               @relation("TripCollector")

  @@index([role])
  @@index([status])
  @@index([lastName, firstName])
  @@map("staff")
}

model StaffLicense {
  id            String      @id @default(uuid(7)) @db.Uuid
  staffId       String      @map("staff_id") @db.Uuid
  licenseType   LicenseType @map("license_type")
  licenseNumber String      @map("license_number") @db.VarChar(50)
  issuer        String      @db.VarChar(100)
  issueDate     DateTime    @map("issue_date") @db.Date
  expiryDate    DateTime    @map("expiry_date") @db.Date
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, licenseNumber])
  @@index([expiryDate])
  @@map("staff_licenses")
}

model StaffCertification {
  id                String            @id @default(uuid(7)) @db.Uuid
  staffId           String            @map("staff_id") @db.Uuid
  type              CertificationType
  name              String            @db.VarChar(150)
  issuer            String?           @db.VarChar(150)
  certificateNumber String?           @map("certificate_number") @db.VarChar(100)
  issueDate         DateTime          @map("issue_date") @db.Date
  // null = no vence
  expiryDate        DateTime?         @map("expiry_date") @db.Date
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiryDate])
  @@map("staff_certifications")
}

model ShiftTemplate {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @unique @db.VarChar(100)
  shiftType    ShiftType @map("shift_type")
  // Hora local "HH:mm"; si endTime <= startTime el turno termina al día siguiente
  startTime    String    @map("start_time") @db.VarChar(5)
  endTime      String    @map("end_time") @db.VarChar(5)
  breakMinutes Int       @default(0) @map("break_minutes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  schedules StaffSchedule[]

  @@map("shift_templates")
}

model StaffSchedule {
  id             String     @id @default(uuid(7)) @db.Uuid
  staffId        String     @map("staff_id") @db.Uuid
  scheduleDate   DateTime   @map("schedule_date") @db.Date
  // null en días de descanso
  startAt        DateTime?  @map("start_at") @db.Timestamptz()
  endAt          DateTime?  @map("end_at") @db.Timestamptz()
  shiftType      ShiftType? @map("shift_type")
  breakMinutes   Int        @default(0) @map("break_minutes")
  isRestDay      Boolean    @default(false) @map("is_rest_day")
  templateId     String?    @map("template_id") @db.Uuid
  notes          String?    @db.Text
  // Motivo cuando un admin fuerza un turno que rompe las reglas de horas
  overrideReason String?    @map("override_reason") @db.Text
  createdById    String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff      Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  template   ShiftTemplate?    @relation(fields: [templateId], references: [id])
  createdBy  User              @relation(fields: [createdById], references: [id])
  attendance StaffAttendance[]

  @@unique([staffId, scheduleDate])
  @@index([scheduleDate])
  @@index([staffId, startAt])
  @@map("staff_schedules")
}

model StaffAttendance {
  id              String           @id @default(uuid(7)) @db.Uuid
  staffId         String           @map("staff_id") @db.Uuid
  // Día del turno (un turno nocturno cuenta para el día en que inicia)
  attendanceDate  DateTime         @map("attendance_date") @db.Date
  // Turno contra el que se calculan retardos y extras; null si no tenía turno
  scheduleId      String?          @map("schedule_id") @db.Uuid
  checkInAt       DateTime?        @map("check_in_at") @db.Timestamptz()
  checkOutAt      DateTime?        @map("check_out_at") @db.Timestamptz()
  status          AttendanceStatus
  lateMinutes     Int              @default(0) @map("late_minutes")
  workedMinutes   Int              @default(0) @map("worked_minutes")
  overtimeMinutes Int              @default(0) @map("overtime_minutes")
  source          AttendanceSource
  // null = registrado por el sistema (cierre del día)
  recordedById    String?          @map("recorded_by") @db.Uuid
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff      Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  schedule   StaffSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  recordedBy User?          @relation(fields: [recordedById], references: [id])

  @@unique([staffId, attendanceDate])
  @@index([attendanceDate])
  @@index([status])
  @@map("staff_attendance")
}

// Catálogo de criterios de evaluación. No se borran, se desactivan.
model EvaluationCriterion {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String      @unique @db.VarChar(100)
  description String?     @db.Text
  weight      Int         @default(1)
  // Vacío = aplica a todos los puestos
  appliesTo   StaffRole[] @default([]) @map("applies_to")
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  scores StaffEvaluationScore[]

  @@map("evaluation_criteria")
}

model StaffEvaluation {
  id              String           @id @default(uuid(7)) @db.Uuid
  staffId         String           @map("staff_id") @db.Uuid
  evaluatorId     String           @map("evaluator_id") @db.Uuid
  periodStart     DateTime         @map("period_start") @db.Date
  periodEnd       DateTime         @map("period_end") @db.Date
  status          EvaluationStatus @default(draft)
  // Promedio ponderado 1.00–5.00; null mientras falten calificaciones
  overallScore    Decimal?         @map("overall_score") @db.Decimal(3, 2)
  strengths       String?          @db.Text
  improvements    String?          @db.Text
  comments        String?          @db.Text
  employeeComment String?          @map("employee_comment") @db.Text
  finalizedAt     DateTime?        @map("finalized_at") @db.Timestamptz()
  acknowledgedAt  DateTime?        @map("acknowledged_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff     Staff                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  evaluator User                   @relation(fields: [evaluatorId], references: [id])
  scores    StaffEvaluationScore[]

  @@index([staffId, periodStart])
  @@index([status])
  @@map("staff_evaluations")
}

model StaffEvaluationScore {
  id            String  @id @default(uuid(7)) @db.Uuid
  evaluationId  String  @map("evaluation_id") @db.Uuid
  criterionId   String  @map("criterion_id") @db.Uuid
  // Copia del catálogo al crear la evaluación
  criterionName String  @map("criterion_name") @db.VarChar(100)
  weight        Int
  // 1–5; null mientras no se califica
  score         Int?    @db.SmallInt
  comment       String? @db.Text

  evaluation StaffEvaluation     @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@map("staff_evaluation_scores")
}

// Historial de salario: para una fecha vale el registro con effectiveFrom más reciente
model StaffCompensation {
  id               String           @id @default(uuid(7)) @db.Uuid
  staffId          String           @map("staff_id") @db.Uuid
  paymentType      PaymentType      @default(daily) @map("payment_type")
  baseSalary       Decimal          @map("base_salary") @db.Decimal(12, 2)
  paymentFrequency PaymentFrequency @default(weekly) @map("payment_frequency")
  effectiveFrom    DateTime         @map("effective_from") @db.Date
  notes            String?          @db.Text
  createdById      String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  staff     Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([staffId, effectiveFrom])
  @@map("staff_compensations")
}

model PayrollPeriod {
  id          String           @id @default(uuid(7)) @db.Uuid
  name        String           @db.VarChar(100)
  frequency   PaymentFrequency @default(weekly)
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date
  status      PayrollStatus    @default(draft)
  generatedAt DateTime?        @map("generated_at") @db.Timestamptz()
  closedAt    DateTime?        @map("closed_at") @db.Timestamptz()
  paidAt      DateTime?        @map("paid_at") @db.Timestamptz()
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy User           @relation(fields: [createdById], references: [id])
  entries   PayrollEntry[]

  @@index([periodStart])
  @@index([status])
  @@map("payroll_periods")
}

// Una línea por empleado y periodo; guarda copia de los datos usados en el cálculo
model PayrollEntry {
  id               String      @id @default(uuid(7)) @db.Uuid
  periodId         String      @map("period_id") @db.Uuid
  staffId          String      @map("staff_id") @db.Uuid
  paymentType      PaymentType @map("payment_type")
  baseSalary       Decimal     @map("base_salary") @db.Decimal(12, 2)
  dailySalary      Decimal     @map("daily_salary") @db.Decimal(12, 2)
  periodDays       Int         @map("period_days")
  payableDays      Decimal     @map("payable_days") @db.Decimal(5, 2)
  absences         Int         @default(0)
  halfDays         Int         @default(0) @map("half_days")
  lates            Int         @default(0)
  lateMinutes      Int         @default(0) @map("late_minutes")
  lateAbsences     Int         @default(0) @map("late_absences")
  overtimeDouble   Decimal     @default(0) @map("overtime_double") @db.Decimal(6, 2)
  overtimeTriple   Decimal     @default(0) @map("overtime_triple") @db.Decimal(6, 2)
  sundaysWorked    Int         @default(0) @map("sundays_worked")
  salaryAmount     Decimal     @map("salary_amount") @db.Decimal(12, 2)
  overtimeAmount   Decimal     @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  sundayPremium    Decimal     @default(0) @map("sunday_premium") @db.Decimal(12, 2)
  totalPerceptions Decimal     @map("total_perceptions") @db.Decimal(12, 2)
  totalDeductions  Decimal     @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPay           Decimal     @map("net_pay") @db.Decimal(12, 2)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  period      PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staff       Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  adjustments PayrollAdjustment[]

  @@unique([periodId, staffId])
  @@map("payroll_entries")
}

model PayrollAdjustment {
  id          String         @id @default(uuid(7)) @db.Uuid
  entryId     String         @map("entry_id") @db.Uuid
  type        AdjustmentType
  concept     String         @db.VarChar(150)
  amount      Decimal        @db.Decimal(12, 2)
  createdById String         @map("created_by") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  entry     PayrollEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id])

  @@index([entryId])
  @@map("payroll_adjustments")
}

// =====================================================
// SISTEMA
// =====================================================

model SystemSetting {
  id           String   @id @default(uuid(7)) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.Text
  settingType  String   @map("setting_type") @db.VarChar(50)
  description  String?  @db.Text
  updatedById  String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  tableName  String     @map("table_name") @db.VarChar(100)
  recordId   String     @map("record_id") @db.Uuid
  actionType ActionType @map("action_type")
  oldValues  Json?      @map("old_values") @db.JsonB
  newValues  Json?      @map("new_values") @db.JsonB
  ipAddress  String?    @map("ip_address") @db.Inet
  userAgent  String?    @map("user_agent") @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName, recordId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}

enum SecurityEventType {
  login_success
  login_failed
  account_locked
  account_unlocked
  logout
  password_changed
  password_reset_requested
  password_reset
  sessions_revoked
  token_reuse
}

// Eventos de acceso y seguridad (complementa audit_logs, que registra cambios de datos)
model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  type      SecurityEventType
  // Usuario afectado; null si el correo no corresponde a ninguna cuenta
  userId    String?           @map("user_id") @db.Uuid
  // Correo usado en el intento (útil en inicios de sesión fallidos)
  email     String?           @db.VarChar(255)
  ipAddress String?           @map("ip_address") @db.VarChar(45)
  userAgent String?           @map("user_agent") @db.Text
  details   Json?             @db.JsonB
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("security_events")
}

// =====================================================
// FLOTA (Módulo 3)
// =====================================================

enum BusType {
  standard
  executive
  luxury
  double_decker
}

model FuelType {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(60)
  // Unidad de medida de las cargas: L, m³, kWh…
  unit      String   @default("L") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  busModels BusModel[]
  fuelLoads FuelLoad[]

  @@map("fuel_types")
}

// Catálogo mínimo; el Módulo 4 (Rutas) lo amplía
model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  /// Zona horaria IANA; los horarios de las rutas se interpretan en la zona de cada terminal
  timezone  String   @default("America/Mexico_City") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  terminals Terminal[]

  @@unique([name, state])
  @@map("cities")
}

model Terminal {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(150)
  cityId    String   @map("city_id") @db.Uuid
  address   String?  @db.Text
  /// Ubicación exacta; sin ella la terminal no se puede usar en unidades ni rutas
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  city                City          @relation(fields: [cityId], references: [id])
  buses               Bus[]
  routesAsOrigin      Route[]       @relation("RouteOrigin")
  routesAsDestination Route[]       @relation("RouteDestination")
  routeStops          RouteStop[]
  ticketsBoarding     Ticket[]      @relation("TicketBoard")
  ticketsAlighting    Ticket[]      @relation("TicketAlight")
  cashSessions        CashSession[]

  @@index([cityId])
  @@map("terminals")
}

model BusModel {
  id                 String   @id @default(uuid(7)) @db.Uuid
  brand              String   @db.VarChar(100)
  model              String   @db.VarChar(100)
  busType            BusType  @default(standard) @map("bus_type")
  fuelTypeId         String   @map("fuel_type_id") @db.Uuid
  tankCapacity       Decimal? @map("tank_capacity") @db.Decimal(8, 2)
  // Rendimiento esperado en km por unidad de combustible (km/L)
  expectedEfficiency Decimal? @map("expected_efficiency") @db.Decimal(6, 2)
  specifications     String?  @db.Text
  features           String[] @default([])
  // Plan preventivo por defecto: lo que llegue primero
  preventiveKm       Int?     @map("preventive_km")
  preventiveDays     Int?     @map("preventive_days")
  // Plantilla de asientos (ver fleet/layout-rules.ts); la capacidad se deriva de ella
  layout             Json     @db.JsonB
  seatCount          Int      @map("seat_count")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  fuelType FuelType @relation(fields: [fuelTypeId], references: [id])
  buses    Bus[]

  @@unique([brand, model])
  @@index([busType])
  @@map("bus_models")
}

enum BusStatus {
  available
  in_service
  maintenance
  out_of_service
}

enum BusDocumentType {
  insurance
  circulation_card
  sict_permit
  emissions_check
  other
}

enum OdometerSource {
  manual
  maintenance
  fuel
  trip
}

/// Unidad propia de la flota. Hereda una copia de los asientos de su modelo.
model Bus {
  id              String    @id @default(uuid(7)) @db.Uuid
  economicNumber  String    @unique @map("economic_number") @db.VarChar(20)
  plates          String    @unique @db.VarChar(15)
  vin             String    @unique @db.VarChar(17)
  year            Int
  busModelId      String    @map("bus_model_id") @db.Uuid
  terminalId      String    @map("terminal_id") @db.Uuid
  odometerKm      Int       @default(0) @map("odometer_km")
  status          BusStatus @default(available)
  statusReason    String?   @map("status_reason") @db.Text
  statusChangedAt DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz()
  /// Primera vez que salió a servicio; después ya no se puede cambiar el modelo
  firstServiceAt  DateTime? @map("first_service_at") @db.Timestamptz()
  /// Plan preventivo propio; null = el del modelo
  preventiveKm    Int?      @map("preventive_km")
  preventiveDays  Int?      @map("preventive_days")
  notes           String?   @db.Text
  /// Último servicio preventivo terminado; base para calcular el próximo
  lastServiceAt   DateTime? @map("last_service_at") @db.Timestamptz()
  lastServiceKm   Int?      @map("last_service_km")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  busModel          BusModel           @relation(fields: [busModelId], references: [id])
  terminal          Terminal           @relation(fields: [terminalId], references: [id])
  seats             BusSeat[]
  documents         BusDocument[]
  readings          OdometerReading[]
  maintenanceOrders MaintenanceOrder[]
  incidents         BusIncident[]
  fuelLoads         FuelLoad[]
  trips             Trip[]

  @@index([status])
  @@index([terminalId])
  @@index([busModelId])
  @@map("buses")
}

model BusSeat {
  id          String    @id @default(uuid(7)) @db.Uuid
  busId       String    @map("bus_id") @db.Uuid
  floor       Int       @default(0)
  row         Int
  col         Int
  number      String    @db.VarChar(6)
  category    String    @default("normal") @db.VarChar(20)
  isBlocked   Boolean   @default(false) @map("is_blocked")
  blockReason String?   @map("block_reason") @db.Text
  blockedAt   DateTime? @map("blocked_at") @db.Timestamptz()

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([busId, number])
  @@map("bus_seats")
}

model BusDocument {
  id         String          @id @default(uuid(7)) @db.Uuid
  busId      String          @map("bus_id") @db.Uuid
  type       BusDocumentType
  folio      String          @db.VarChar(60)
  issuer     String?         @db.VarChar(150)
  issueDate  DateTime        @map("issue_date") @db.Date
  expiryDate DateTime?       @map("expiry_date") @db.Date
  notes      String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([busId, type])
  @@index([expiryDate])
  @@map("bus_documents")
}

model OdometerReading {
  id         String         @id @default(uuid(7)) @db.Uuid
  busId      String         @map("bus_id") @db.Uuid
  km         Int
  source     OdometerSource @default(manual)
  recordedBy String?        @map("recorded_by") @db.Uuid
  recordedAt DateTime       @default(now()) @map("recorded_at") @db.Timestamptz()

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([busId, recordedAt])
  @@map("odometer_readings")
}

enum MaintenanceType {
  preventive
  corrective
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum MaintenancePriority {
  normal
  urgent
}

/// Orden de trabajo de mantenimiento de una unidad.
model MaintenanceOrder {
  id            String              @id @default(uuid(7)) @db.Uuid
  folio         Int                 @unique @default(autoincrement())
  busId         String              @map("bus_id") @db.Uuid
  type          MaintenanceType
  status        MaintenanceStatus   @default(scheduled)
  priority      MaintenancePriority @default(normal)
  description   String              @db.Text
  scheduledDate DateTime            @map("scheduled_date") @db.Date
  externalShop  String?             @map("external_shop") @db.VarChar(150)
  mechanicId    String?             @map("mechanic_id") @db.Uuid
  startedAt     DateTime?           @map("started_at") @db.Timestamptz()
  startKm       Int?                @map("start_km")
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz()
  endKm         Int?                @map("end_km")
  workPerformed String?             @map("work_performed") @db.Text
  laborCost     Decimal?            @map("labor_cost") @db.Decimal(12, 2)
  partsCost     Decimal?            @map("parts_cost") @db.Decimal(12, 2)
  cancelReason  String?             @map("cancel_reason") @db.Text
  /// Incidencia de la que nació la orden (correctivas)
  incidentId    String?             @map("incident_id") @db.Uuid
  createdBy     String?             @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  bus      Bus               @relation(fields: [busId], references: [id])
  mechanic User?             @relation("MaintenanceMechanic", fields: [mechanicId], references: [id])
  tasks    MaintenanceTask[]
  incident BusIncident?      @relation(fields: [incidentId], references: [id])

  @@index([busId, status])
  @@index([status, scheduledDate])
  @@index([mechanicId])
  @@index([incidentId])
  @@map("maintenance_orders")
}

model MaintenanceTask {
  id          String    @id @default(uuid(7)) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  description String    @db.VarChar(200)
  sortOrder   Int       @default(0) @map("sort_order")
  isDone      Boolean   @default(false) @map("is_done")
  doneAt      DateTime? @map("done_at") @db.Timestamptz()

  order MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("maintenance_tasks")
}

/// Catálogo de tareas base que se copian a cada orden preventiva nueva.
model MaintenanceTaskTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  description String   @unique @db.VarChar(200)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("maintenance_task_templates")
}

// =====================================================
// FLOTA: INCIDENCIAS (3.3)
// =====================================================

enum IncidentSeverity {
  low
  medium
  high
  /// No puede circular: la unidad sale de servicio al reportarse
  critical
}

enum IncidentStatus {
  reported
  in_review
  resolved
  dismissed
}

/// Catálogo editable de categorías de incidencia.
model IncidentCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @unique @db.VarChar(80)
  /// Pide los datos del siniestro (aseguradora, terceros, lesionados)
  isAccident Boolean  @default(false) @map("is_accident")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  incidents BusIncident[]

  @@map("incident_categories")
}

/// Incidencia reportada sobre una unidad (falla, daño, accidente…).
model BusIncident {
  id           String           @id @default(uuid(7)) @db.Uuid
  folio        Int              @unique @default(autoincrement())
  busId        String           @map("bus_id") @db.Uuid
  categoryId   String           @map("category_id") @db.Uuid
  severity     IncidentSeverity
  status       IncidentStatus   @default(reported)
  description  String           @db.Text
  location     String?          @db.VarChar(200)
  occurredAt   DateTime         @map("occurred_at") @db.Timestamptz()
  odometerKm   Int?             @map("odometer_km")
  reportedBy   String           @map("reported_by") @db.Uuid
  // Datos del siniestro (solo categorías de accidente)
  claimNumber  String?          @map("claim_number") @db.VarChar(50)
  insurer      String?          @db.VarChar(150)
  thirdParties Boolean?         @map("third_parties")
  injuries     Boolean?
  // Atención
  reviewedBy   String?          @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz()
  closedAt     DateTime?        @map("closed_at") @db.Timestamptz()
  resolution   String?          @db.Text
  /// La incidencia sacó la unidad de servicio (crítica con la unidad disponible)
  tookBusOut   Boolean          @default(false) @map("took_bus_out")
  /// Recorrido en el que ocurrió (Módulo 5); null = fuera de recorrido
  tripId       String?          @map("trip_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  bus      Bus                @relation(fields: [busId], references: [id])
  category IncidentCategory   @relation(fields: [categoryId], references: [id])
  reporter User               @relation("IncidentReporter", fields: [reportedBy], references: [id])
  reviewer User?              @relation("IncidentReviewer", fields: [reviewedBy], references: [id])
  trip     Trip?              @relation(fields: [tripId], references: [id])
  orders   MaintenanceOrder[]

  @@index([busId, status])
  @@index([tripId])
  @@index([status, severity])
  @@index([reportedBy])
  @@map("bus_incidents")
}

// =====================================================
// FLOTA: COMBUSTIBLE (3.4)
// =====================================================

enum FuelLoadStatus {
  /// Registrada por el conductor; no cuenta hasta que coordinación la confirme
  pending
  confirmed
  rejected
}

/// Carga de combustible de una unidad. El rendimiento se mide de tanque lleno a tanque lleno.
model FuelLoad {
  id           String         @id @default(uuid(7)) @db.Uuid
  busId        String         @map("bus_id") @db.Uuid
  /// Combustible del modelo al momento de la carga
  fuelTypeId   String         @map("fuel_type_id") @db.Uuid
  loadedAt     DateTime       @map("loaded_at") @db.Timestamptz()
  quantity     Decimal        @db.Decimal(8, 2)
  unitPrice    Decimal        @map("unit_price") @db.Decimal(10, 3)
  total        Decimal        @db.Decimal(12, 2)
  odometerKm   Int            @map("odometer_km")
  isFullTank   Boolean        @default(true) @map("is_full_tank")
  station      String?        @db.VarChar(150)
  ticket       String?        @db.VarChar(60)
  notes        String?        @db.Text
  status       FuelLoadStatus @default(confirmed)
  rejectReason String?        @map("reject_reason") @db.Text
  recordedBy   String         @map("recorded_by") @db.Uuid
  reviewedBy   String?        @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime?      @map("reviewed_at") @db.Timestamptz()
  /// Solo en tanques llenos que cierran un tramo medido
  tripKm       Int?           @map("trip_km")
  tripQuantity Decimal?       @map("trip_quantity") @db.Decimal(10, 2)
  efficiency   Decimal?       @db.Decimal(6, 2)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  bus      Bus      @relation(fields: [busId], references: [id])
  fuelType FuelType @relation(fields: [fuelTypeId], references: [id])
  recorder User     @relation("FuelLoadRecorder", fields: [recordedBy], references: [id])
  reviewer User?    @relation("FuelLoadReviewer", fields: [reviewedBy], references: [id])

  @@index([busId, status, odometerKm])
  @@index([status])
  @@index([loadedAt])
  @@index([recordedBy])
  @@map("fuel_loads")
}

// =====================================================
// MÓDULO 4: RUTAS
// =====================================================

model Route {
  id                       String   @id @default(uuid(7)) @db.Uuid
  code                     String   @unique @db.VarChar(20)
  name                     String   @db.VarChar(255)
  originTerminalId         String   @map("origin_terminal_id") @db.Uuid
  destinationTerminalId    String   @map("destination_terminal_id") @db.Uuid
  basePrice                Decimal  @map("base_price") @db.Decimal(10, 2)
  estimatedDurationMinutes Int      @map("estimated_duration_minutes")
  /// Suma de los tramos; con paradas se calcula sola. Sin paradas es opcional
  distanceKm               Decimal? @map("distance_km") @db.Decimal(8, 2)
  description              String?  @db.Text
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  originTerminal      Terminal        @relation("RouteOrigin", fields: [originTerminalId], references: [id])
  destinationTerminal Terminal        @relation("RouteDestination", fields: [destinationTerminalId], references: [id])
  stops               RouteStop[]
  schedules           RouteSchedule[]
  trips               Trip[]

  @@index([originTerminalId, destinationTerminalId])
  @@index([destinationTerminalId])
  @@index([isActive])
  @@map("routes")
}

model RouteStop {
  id                        String   @id @default(uuid(7)) @db.Uuid
  routeId                   String   @map("route_id") @db.Uuid
  terminalId                String   @map("terminal_id") @db.Uuid
  stopOrder                 Int      @map("stop_order")
  durationFromOriginMinutes Int      @map("duration_from_origin_minutes")
  /// Km acumulados desde el origen
  kmFromOrigin              Decimal  @map("km_from_origin") @db.Decimal(8, 2)
  /// Precio del boleto del origen hasta esta parada; un tramo entre paradas cuesta la diferencia
  priceFromOrigin           Decimal  @map("price_from_origin") @db.Decimal(10, 2)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  terminal Terminal @relation(fields: [terminalId], references: [id])

  @@unique([routeId, stopOrder])
  @@unique([routeId, terminalId])
  @@index([terminalId])
  @@map("route_stops")
}

model RouteSchedule {
  id            String    @id @default(uuid(7)) @db.Uuid
  routeId       String    @map("route_id") @db.Uuid
  /// Hora local de salida en la zona de la terminal de origen
  departureTime DateTime  @map("departure_time") @db.Time()
  /// 0 = domingo … 6 = sábado
  daysOfWeek    Int[]     @map("days_of_week")
  validFrom     DateTime  @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  route Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  trips Trip[]

  @@index([routeId])
  @@index([validFrom, validUntil])
  @@map("route_schedules")
}

enum SeasonType {
  low
  normal
  high
  holiday
}

/// Temporadas globales: aplican a todas las rutas y no se solapan entre las activas
model Season {
  id                   String     @id @default(uuid(7)) @db.Uuid
  name                 String     @db.VarChar(100)
  seasonType           SeasonType @map("season_type")
  validFrom            DateTime   @map("valid_from") @db.Date
  validUntil           DateTime   @map("valid_until") @db.Date
  /// Negativo en baja temporada, positivo en alta
  priceModifierPercent Decimal    @map("price_modifier_percent") @db.Decimal(5, 2)
  description          String?    @db.Text
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([validFrom, validUntil])
  @@map("seasons")
}

// =====================================================
// RECORRIDOS (Módulo 5)
// =====================================================

/// Ciclo y transiciones válidas en trips/trip-rules.ts
enum TripStatus {
  scheduled
  boarding
  in_transit
  delayed
  completed
  cancelled
}

/// Un horario de ruta en una fecha (o un recorrido extra sin horario).
model Trip {
  id                String     @id @default(uuid(7)) @db.Uuid
  /// Clave legible: ruta-AAMMDD-HHMM (los extras llevan -E y un número)
  tripNumber        String     @unique @map("trip_number") @db.VarChar(40)
  routeId           String     @map("route_id") @db.Uuid
  /// null = recorrido extra (refuerzo o especial)
  routeScheduleId   String?    @map("route_schedule_id") @db.Uuid
  /// Fecha de salida en la zona del origen
  tripDate          DateTime   @map("trip_date") @db.Date
  departureAt       DateTime   @map("departure_at") @db.Timestamptz()
  arrivalAt         DateTime   @map("arrival_at") @db.Timestamptz()
  /// Copia de la duración de la ruta al generarlo
  durationMinutes   Int        @map("duration_minutes")
  status            TripStatus @default(scheduled)
  busId             String?    @map("bus_id") @db.Uuid
  driverId          String?    @map("driver_id") @db.Uuid
  collectorId       String?    @map("collector_id") @db.Uuid
  /// Motivo cuando un admin fuerza una asignación que rompe las reglas de horas
  overrideReason    String?    @map("override_reason") @db.Text
  actualDepartureAt DateTime?  @map("actual_departure_at") @db.Timestamptz()
  actualArrivalAt   DateTime?  @map("actual_arrival_at") @db.Timestamptz()
  startOdometerKm   Int?       @map("start_odometer_km")
  endOdometerKm     Int?       @map("end_odometer_km")
  notes             String?    @db.Text
  cancelReason      String?    @map("cancel_reason") @db.Text
  cancelledAt       DateTime?  @map("cancelled_at") @db.Timestamptz()
  cancelledById     String?    @map("cancelled_by") @db.Uuid
  /// null = lo generó el sistema
  createdById       String?    @map("created_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  route       Route           @relation(fields: [routeId], references: [id])
  schedule    RouteSchedule?  @relation(fields: [routeScheduleId], references: [id])
  bus         Bus?            @relation(fields: [busId], references: [id])
  driver      Staff?          @relation("TripDriver", fields: [driverId], references: [id])
  collector   Staff?          @relation("TripCollector", fields: [collectorId], references: [id])
  cancelledBy User?           @relation("TripCanceller", fields: [cancelledById], references: [id])
  createdBy   User?           @relation("TripCreator", fields: [createdById], references: [id])
  statusLog   TripStatusLog[]
  incidents   BusIncident[]
  tickets     Ticket[]

  // Unidad, conductor y cobrador sin recorridos encimados: exclusion constraints en la migración (btree_gist)
  @@unique([routeScheduleId, tripDate])
  @@index([tripDate, status])
  @@index([routeId, tripDate])
  @@index([busId, departureAt])
  @@index([driverId, departureAt])
  @@index([collectorId, departureAt])
  @@map("trips")
}

/// Historial de cambios de estado de un recorrido.
model TripStatusLog {
  id          String      @id @default(uuid(7)) @db.Uuid
  tripId      String      @map("trip_id") @db.Uuid
  /// null en el alta
  fromStatus  TripStatus? @map("from_status")
  toStatus    TripStatus  @map("to_status")
  reason      String?     @db.Text
  /// null = lo hizo el sistema
  changedById String?     @map("changed_by") @db.Uuid
  changedAt   DateTime    @default(now()) @map("changed_at") @db.Timestamptz()

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([tripId, changedAt])
  @@map("trip_status_log")
}

// =====================================================
// BOLETOS (Módulo 6)
// =====================================================

enum SaleChannel {
  counter
  online
}

/// Una compra (carrito): agrupa boletos, pagos y reembolsos
enum OrderStatus {
  /// Asientos apartados esperando el pago
  pending
  paid
  /// Venció el apartado sin pagar
  expired
  cancelled
}

/// Ciclo y transiciones válidas en tickets/ticket-status-rules.ts
enum TicketStatus {
  /// Apartado mientras se paga (vence con la orden)
  held
  confirmed
  checked_in
  no_show
  cancelled
  /// Se cambió por otro boleto (otro horario o asiento)
  changed
}

enum PaymentMethod {
  cash
  card
  transfer
  mercadopago
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
}

enum DiscountType {
  percent
  amount
}

enum CashSessionStatus {
  open
  closed
}

enum CashMovementType {
  sale
  refund
  /// Retiro de efectivo (envío a bóveda)
  withdrawal
  /// Ingreso de efectivo (cambio adicional)
  deposit
}

enum TicketEventType {
  held
  released
  confirmed
  changed
  checked_in
  no_show
  cancelled
  refunded
}

/// Quien compra; en taquilla es opcional
model Customer {
  id        String   @id @default(uuid(7)) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  orders Order[]

  @@index([email])
  @@index([phone])
  @@map("customers")
}

/// Tipo de pasajero con su descuento (adulto, niño, INAPAM, estudiante…)
model PassengerType {
  id              String       @id @default(uuid(7)) @db.Uuid
  code            String       @unique @db.VarChar(20)
  name            String       @db.VarChar(100)
  discountPercent Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  /// Máximo de boletos con este tipo por recorrido (null = sin cupo)
  maxPerTrip      Int?         @map("max_per_trip")
  /// Al abordar se pide credencial o identificación
  requiresId      Boolean      @default(false) @map("requires_id")
  /// El descuento solo aplica si la fecha del viaje cae en una temporada de estos tipos (vacío = siempre)
  seasonTypes     SeasonType[] @default([]) @map("season_types")
  /// Tipo que se propone al capturar un pasajero
  isDefault       Boolean      @default(false) @map("is_default")
  isActive        Boolean      @default(true) @map("is_active")
  sortOrder       Int          @default(0) @map("sort_order")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tickets Ticket[]

  @@map("passenger_types")
}

model Promotion {
  id            String        @id @default(uuid(7)) @db.Uuid
  code          String        @unique @db.VarChar(30)
  name          String        @db.VarChar(150)
  description   String?       @db.Text
  discountType  DiscountType  @map("discount_type")
  discountValue Decimal       @map("discount_value") @db.Decimal(10, 2)
  /// Tope del descuento cuando es porcentaje
  maxDiscount   Decimal?      @map("max_discount") @db.Decimal(10, 2)
  maxUses       Int?          @map("max_uses")
  usesCount     Int           @default(0) @map("uses_count")
  minPurchase   Decimal       @default(0) @map("min_purchase") @db.Decimal(10, 2)
  validFrom     DateTime      @map("valid_from") @db.Date
  validUntil    DateTime      @map("valid_until") @db.Date
  /// Canales donde se acepta (vacío = todos)
  channels      SaleChannel[] @default([])
  isActive      Boolean       @default(true) @map("is_active")
  createdById   String?       @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  createdBy User?            @relation("PromotionCreator", fields: [createdById], references: [id])
  orders    OrderPromotion[]

  @@index([validFrom, validUntil])
  @@map("promotions")
}

model Order {
  id            String      @id @default(uuid(7)) @db.Uuid
  /// Folio legible de la compra (secuencia order_number_seq)
  orderNumber   String      @unique @map("order_number") @db.VarChar(20)
  channel       SaleChannel
  status        OrderStatus @default(pending)
  customerId    String?     @map("customer_id") @db.Uuid
  /// Correo al que se mandan los boletos (en línea es obligatorio)
  contactEmail  String?     @map("contact_email") @db.VarChar(255)
  contactPhone  String?     @map("contact_phone") @db.VarChar(20)
  /// Vendedor en taquilla; null en línea
  sellerId      String?     @map("seller_id") @db.Uuid
  cashSessionId String?     @map("cash_session_id") @db.Uuid
  /// Suma de los boletos: tarifa, descuentos, IVA, cargo en línea y total
  subtotal      Decimal     @default(0) @db.Decimal(10, 2)
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  vat           Decimal     @default(0) @db.Decimal(10, 2)
  serviceFee    Decimal     @default(0) @map("service_fee") @db.Decimal(10, 2)
  total         Decimal     @default(0) @db.Decimal(10, 2)
  /// Fin del apartado mientras está pendiente
  expiresAt     DateTime?   @map("expires_at") @db.Timestamptz()
  paidAt        DateTime?   @map("paid_at") @db.Timestamptz()
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz()
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  customer    Customer?        @relation(fields: [customerId], references: [id])
  seller      User?            @relation("OrderSeller", fields: [sellerId], references: [id])
  cashSession CashSession?     @relation(fields: [cashSessionId], references: [id])
  tickets     Ticket[]
  payments    Payment[]
  refunds     Refund[]
  promotions  OrderPromotion[]

  @@index([status, expiresAt])
  @@index([sellerId, createdAt])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model OrderPromotion {
  id              String  @id @default(uuid(7)) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  promotionId     String  @map("promotion_id") @db.Uuid
  discountApplied Decimal @map("discount_applied") @db.Decimal(10, 2)

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@unique([orderId, promotionId])
  @@index([promotionId])
  @@map("order_promotions")
}

/// Un boleto por pasajero y tramo. El precio se congela al venderlo.
model Ticket {
  id                String       @id @default(uuid(7)) @db.Uuid
  /// Folio legible del boleto (secuencia ticket_number_seq)
  ticketNumber      String       @unique @map("ticket_number") @db.VarChar(20)
  orderId           String       @map("order_id") @db.Uuid
  tripId            String       @map("trip_id") @db.Uuid
  /// Número de asiento (no el id): sobrevive a un cambio de unidad con el mismo acomodo
  seatNumber        String       @map("seat_number") @db.VarChar(6)
  /// Índices del itinerario de la ruta (0 = origen); el pasajero ocupa el asiento en [board, alight)
  boardIndex        Int          @map("board_index")
  alightIndex       Int          @map("alight_index")
  boardTerminalId   String       @map("board_terminal_id") @db.Uuid
  alightTerminalId  String       @map("alight_terminal_id") @db.Uuid
  /// Instantes de subida y bajada según el itinerario
  boardAt           DateTime     @map("board_at") @db.Timestamptz()
  alightAt          DateTime     @map("alight_at") @db.Timestamptz()
  passengerName     String       @map("passenger_name") @db.VarChar(255)
  passengerTypeId   String       @map("passenger_type_id") @db.Uuid
  passengerDocument String?      @map("passenger_document") @db.VarChar(50)
  /// Tarifa del tramo con temporada
  basePrice         Decimal      @map("base_price") @db.Decimal(10, 2)
  seasonPercent     Decimal?     @map("season_percent") @db.Decimal(5, 2)
  passengerDiscount Decimal      @default(0) @map("passenger_discount") @db.Decimal(10, 2)
  promoDiscount     Decimal      @default(0) @map("promo_discount") @db.Decimal(10, 2)
  /// IVA contenido en el total (sin el cargo en línea)
  vat               Decimal      @default(0) @db.Decimal(10, 2)
  serviceFee        Decimal      @default(0) @map("service_fee") @db.Decimal(10, 2)
  total             Decimal      @db.Decimal(10, 2)
  status            TicketStatus @default(held)
  /// Token firmado que va en el QR
  qrToken           String?      @unique @map("qr_token") @db.VarChar(255)
  checkedInAt       DateTime?    @map("checked_in_at") @db.Timestamptz()
  checkedInById     String?      @map("checked_in_by") @db.Uuid
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz()
  cancelReason      String?      @map("cancel_reason") @db.Text
  /// Boleto que lo reemplazó al cambiarlo
  replacedById      String?      @unique @map("replaced_by") @db.Uuid
  /// Saldo por devolver cuando la empresa canceló el recorrido (se reembolsa o se usa al reubicar)
  refundDue         Decimal?     @map("refund_due") @db.Decimal(10, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  order          Order         @relation(fields: [orderId], references: [id])
  trip           Trip          @relation(fields: [tripId], references: [id])
  boardTerminal  Terminal      @relation("TicketBoard", fields: [boardTerminalId], references: [id])
  alightTerminal Terminal      @relation("TicketAlight", fields: [alightTerminalId], references: [id])
  passengerType  PassengerType @relation(fields: [passengerTypeId], references: [id])
  checkedInBy    User?         @relation("TicketCheckIn", fields: [checkedInById], references: [id])
  replacedBy     Ticket?       @relation("TicketChange", fields: [replacedById], references: [id])
  replaces       Ticket?       @relation("TicketChange")
  refunds        Refund[]
  events         TicketEvent[]

  // Mismo asiento sin tramos encimados entre boletos activos: exclusion constraint en la migración (btree_gist)
  @@index([tripId, status])
  @@index([orderId])
  @@index([passengerTypeId])
  @@map("tickets")
}

model Payment {
  id               String        @id @default(uuid(7)) @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(pending)
  amount           Decimal       @db.Decimal(10, 2)
  /// Efectivo recibido (para calcular el cambio)
  received         Decimal?      @db.Decimal(10, 2)
  /// Autorización de la terminal, referencia de la transferencia, etc.
  reference        String?       @db.VarChar(100)
  /// Id del pago en la pasarela (único para que el webhook sea idempotente)
  gatewayPaymentId String?       @unique @map("gateway_payment_id") @db.VarChar(100)
  gatewayResponse  Json?         @map("gateway_response") @db.JsonB
  cashSessionId    String?       @map("cash_session_id") @db.Uuid
  recordedById     String?       @map("recorded_by") @db.Uuid
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz()
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  order       Order        @relation(fields: [orderId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  recordedBy  User?        @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([cashSessionId])
  @@index([paidAt])
  @@map("payments")
}

model Refund {
  id              String        @id @default(uuid(7)) @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  /// null = reembolso de la orden completa
  ticketId        String?       @map("ticket_id") @db.Uuid
  method          PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  reason          String        @db.Text
  gatewayRefundId String?       @unique @map("gateway_refund_id") @db.VarChar(100)
  cashSessionId   String?       @map("cash_session_id") @db.Uuid
  createdById     String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  order       Order        @relation(fields: [orderId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  createdBy   User?        @relation("RefundCreator", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([ticketId])
  @@index([createdAt])
  @@map("refunds")
}

/// Caja de un vendedor: de la apertura al corte. Solo una abierta por usuario (índice parcial en la migración)
model CashSession {
  id                String            @id @default(uuid(7)) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  terminalId        String?           @map("terminal_id") @db.Uuid
  status            CashSessionStatus @default(open)
  openingFloat      Decimal           @map("opening_float") @db.Decimal(10, 2)
  openedAt          DateTime          @default(now()) @map("opened_at") @db.Timestamptz()
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz()
  /// Efectivo que debía haber al corte (fondo + ventas − reembolsos − retiros + ingresos)
  expectedCash      Decimal?          @map("expected_cash") @db.Decimal(10, 2)
  countedCash       Decimal?          @map("counted_cash") @db.Decimal(10, 2)
  difference        Decimal?          @db.Decimal(10, 2)
  closingNotes      String?           @map("closing_notes") @db.Text
  closedById        String?           @map("closed_by") @db.Uuid
  /// % de comisión del vendedor vigente al cortar (congelado)
  commissionPercent Decimal?          @map("commission_percent") @db.Decimal(5, 2)
  commissionAmount  Decimal?          @map("commission_amount") @db.Decimal(10, 2)
  /// Resumen congelado al cortar: totales por método, compras, boletos y desglose de billetes y monedas
  summary           Json?             @db.JsonB
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  user      User           @relation("CashSessionUser", fields: [userId], references: [id])
  terminal  Terminal?      @relation(fields: [terminalId], references: [id])
  closedBy  User?          @relation("CashSessionCloser", fields: [closedById], references: [id])
  movements CashMovement[]
  orders    Order[]
  payments  Payment[]
  refunds   Refund[]

  @@index([userId, openedAt])
  @@index([status])
  @@map("cash_sessions")
}

model CashMovement {
  id          String           @id @default(uuid(7)) @db.Uuid
  sessionId   String           @map("session_id") @db.Uuid
  type        CashMovementType
  method      PaymentMethod
  /// Siempre positivo; el tipo dice si entra o sale
  amount      Decimal          @db.Decimal(10, 2)
  paymentId   String?          @unique @map("payment_id") @db.Uuid
  refundId    String?          @unique @map("refund_id") @db.Uuid
  reason      String?          @db.Text
  createdById String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  session   CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("CashMovementCreator", fields: [createdById], references: [id])

  @@index([sessionId, createdAt])
  @@map("cash_movements")
}

/// Historial de cada boleto (venta, cambio, check-in, cancelación, reembolso)
model TicketEvent {
  id        String          @id @default(uuid(7)) @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  type      TicketEventType
  detail    Json?           @db.JsonB
  /// null = lo hizo el sistema (vencimiento, no presentado, recorrido cancelado)
  userId    String?         @map("user_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation("TicketEventUser", fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@index([type, createdAt])
  @@map("ticket_events")
}

// =====================================================
// ARCHIVOS
// =====================================================

/// Archivos pequeños guardados en la base (logo de la empresa). Para archivos grandes se usaría S3/R2.
model StoredFile {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Para qué se usa (p. ej. company_logo)
  purpose     String   @db.VarChar(40)
  fileName    String   @map("file_name") @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(100)
  size        Int
  data        Bytes
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([purpose])
  @@map("stored_files")
}
