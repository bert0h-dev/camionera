// Esquema de la central camionera.
// Fuente de diseño: contexto/01-EsquemaBD.prisma (con los ajustes de docs/02-revision-esquema-bd.md).
// Los modelos se agregan por módulo conforme avanzamos.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  admin
  coordinator
  supervisor
  hr
  driver
  collector
  vendor
  viewer
}

enum StaffRole {
  driver
  collector
  mechanic
  supervisor
  vendor
  hr
  admin_staff
}

enum StaffStatus {
  active
  inactive
  vacation
  sick_leave
  suspended
}

enum LicenseType {
  A
  B
  C
  D
  E
}

enum CertificationType {
  medical_exam
  first_aid
  defensive_driving
  training
  other
}

enum ShiftType {
  morning
  afternoon
  night
  split
}

enum ActionType {
  insert
  update
  delete
}

// =====================================================
// AUTH / USERS
// =====================================================

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(viewer)
  fullName     String    @map("full_name") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff          Staff?
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]
  settings       SystemSetting[]
  schedules      StaffSchedule[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

// =====================================================
// PERSONAL
// =====================================================

model Staff {
  id                String      @id @default(uuid(7)) @db.Uuid
  // Generado desde la secuencia staff_employee_number_seq (ver StaffService)
  employeeNumber    String      @unique @map("employee_number") @db.VarChar(20)
  firstName         String      @map("first_name") @db.VarChar(100)
  lastName          String      @map("last_name") @db.VarChar(100)
  secondLastName    String?     @map("second_last_name") @db.VarChar(100)
  curp              String?     @unique @db.VarChar(18)
  rfc               String?     @unique @db.VarChar(13)
  nss               String?     @unique @db.VarChar(11)
  birthDate         DateTime    @map("birth_date") @db.Date
  email             String?     @db.VarChar(255)
  phone             String      @db.VarChar(20)
  address           String?     @db.Text
  emergencyContact  String?     @map("emergency_contact") @db.VarChar(255)
  emergencyPhone    String?     @map("emergency_phone") @db.VarChar(20)
  role              StaffRole
  status            StaffStatus @default(active)
  hireDate          DateTime    @map("hire_date") @db.Date
  terminationDate   DateTime?   @map("termination_date") @db.Date
  terminationReason String?     @map("termination_reason") @db.Text
  userId            String?     @unique @map("user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user           User?                @relation(fields: [userId], references: [id])
  licenses       StaffLicense[]
  certifications StaffCertification[]
  schedules      StaffSchedule[]

  @@index([role])
  @@index([status])
  @@index([lastName, firstName])
  @@map("staff")
}

model StaffLicense {
  id            String      @id @default(uuid(7)) @db.Uuid
  staffId       String      @map("staff_id") @db.Uuid
  licenseType   LicenseType @map("license_type")
  licenseNumber String      @map("license_number") @db.VarChar(50)
  issuer        String      @db.VarChar(100)
  issueDate     DateTime    @map("issue_date") @db.Date
  expiryDate    DateTime    @map("expiry_date") @db.Date
  notes         String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, licenseNumber])
  @@index([expiryDate])
  @@map("staff_licenses")
}

model StaffCertification {
  id                String            @id @default(uuid(7)) @db.Uuid
  staffId           String            @map("staff_id") @db.Uuid
  type              CertificationType
  name              String            @db.VarChar(150)
  issuer            String?           @db.VarChar(150)
  certificateNumber String?           @map("certificate_number") @db.VarChar(100)
  issueDate         DateTime          @map("issue_date") @db.Date
  // null = no vence
  expiryDate        DateTime?         @map("expiry_date") @db.Date
  notes             String?           @db.Text
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiryDate])
  @@map("staff_certifications")
}

model ShiftTemplate {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @unique @db.VarChar(100)
  shiftType    ShiftType @map("shift_type")
  // Hora local "HH:mm"; si endTime <= startTime el turno termina al día siguiente
  startTime    String    @map("start_time") @db.VarChar(5)
  endTime      String    @map("end_time") @db.VarChar(5)
  breakMinutes Int       @default(0) @map("break_minutes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  schedules StaffSchedule[]

  @@map("shift_templates")
}

model StaffSchedule {
  id             String     @id @default(uuid(7)) @db.Uuid
  staffId        String     @map("staff_id") @db.Uuid
  scheduleDate   DateTime   @map("schedule_date") @db.Date
  // null en días de descanso
  startAt        DateTime?  @map("start_at") @db.Timestamptz()
  endAt          DateTime?  @map("end_at") @db.Timestamptz()
  shiftType      ShiftType? @map("shift_type")
  breakMinutes   Int        @default(0) @map("break_minutes")
  isRestDay      Boolean    @default(false) @map("is_rest_day")
  templateId     String?    @map("template_id") @db.Uuid
  notes          String?    @db.Text
  // Motivo cuando un admin fuerza un turno que rompe las reglas de horas
  overrideReason String?    @map("override_reason") @db.Text
  createdById    String     @map("created_by") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  staff     Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  template  ShiftTemplate? @relation(fields: [templateId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@unique([staffId, scheduleDate])
  @@index([scheduleDate])
  @@index([staffId, startAt])
  @@map("staff_schedules")
}

// =====================================================
// SISTEMA
// =====================================================

model SystemSetting {
  id           String   @id @default(uuid(7)) @db.Uuid
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.Text
  settingType  String   @map("setting_type") @db.VarChar(50)
  description  String?  @db.Text
  updatedById  String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@map("system_settings")
}

model AuditLog {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  tableName  String     @map("table_name") @db.VarChar(100)
  recordId   String     @map("record_id") @db.Uuid
  actionType ActionType @map("action_type")
  oldValues  Json?      @map("old_values") @db.JsonB
  newValues  Json?      @map("new_values") @db.JsonB
  ipAddress  String?    @map("ip_address") @db.Inet
  userAgent  String?    @map("user_agent") @db.Text
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName, recordId])
  @@index([actionType])
  @@index([createdAt])
  @@map("audit_logs")
}
