PORT=3002
FRONTEND_URL=http://localhost:5173

# Neon: conexión con pooler (host con -pooler) para la aplicación
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"
# Neon: conexión directa (sin -pooler) para migraciones
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"

# Auth
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Seed: administrador inicial
SEED_ADMIN_EMAIL=admin@camionera.mx
SEED_ADMIN_PASSWORD=cambia-esto
SEED_ADMIN_NAME=Administrador

# Correo (Resend). Sin la clave los correos solo se escriben en el log
RESEND_API_KEY=
MAIL_FROM="Central Camionera <onboarding@resend.dev>"
